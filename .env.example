# Copy this file to .env.local, then fill in private values locally.
# Never commit real passwords or API keys.

# The one site origin allowed to create administrator sessions.
# Scheme, host, and port must match the browser address exactly.
APP_ORIGIN=http://127.0.0.1:3001

# Menu reads stay on JSON unless database mode is selected explicitly.
MENU_READ_SOURCE=json

# Optional: only needed by the Ark dish image generation tools.
ARK_API_KEY=

# Local PostgreSQL container settings.
# The non-secret defaults keep each local project isolated.
POSTGRES_PORT=5434
POSTGRES_DB=menu_dev
POSTGRES_OWNER=menu_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_USER=menu_app
POSTGRES_APP_PASSWORD=

# Used only for Prisma migrations and database maintenance.
DATABASE_ADMIN_URL=

# Used by the application at runtime with the limited menu_app role.
DATABASE_URL=
