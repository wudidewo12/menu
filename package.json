{
  "name": "menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node tools/sync-menu-seed.mjs",
    "dev": "node tools/dev-server.mjs",
    "build": "next build",
    "start": "node server.js",
    "next:dev": "next dev --turbopack",
    "lint": "next lint",
    "image:replace": "node tools/ark-image-replace.mjs",
    "image:review": "node tools/generate-dish-review-images.mjs",
    "db:config": "docker compose --env-file .env.local config --quiet",
    "db:up": "docker compose --env-file .env.local up -d postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:status": "docker compose --env-file .env.local ps",
    "db:logs": "docker compose --env-file .env.local logs -f postgres"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "^17.4.2",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prisma": "7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "next>sharp": "-"
    }
  }
}
