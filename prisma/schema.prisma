generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DishStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DishDifficulty {
  EASY
  MEDIUM
  HARD
}

model Menu {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  title       String
  subtitle    String?
  status      MenuStatus @default(DRAFT)
  version     Int        @default(1)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuDishes  MenuDish[]
}

model Dish {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  name        String
  description String
  prepMinutes Int
  category    String
  accent      String?
  difficulty  DishDifficulty @default(EASY)
  servingsMin Int
  servingsMax Int
  ingredients String[]       @default([])
  status      DishStatus     @default(DRAFT)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  menuDishes  MenuDish[]
}

model MenuDish {
  menuId      String   @db.Uuid
  dishId      Int
  recommended Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([menuId, dishId])
  @@index([menuId, visible, sortOrder])
  @@index([dishId])
}
