generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MenuStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DishStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DishDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AdminRole {
  OWNER
  EDITOR
  VIEWER
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id                  String         @id @default(uuid(7)) @db.Uuid
  email               String         @unique
  displayName         String
  passwordHash        String
  role                AdminRole      @default(VIEWER)
  status              AdminStatus    @default(DISABLED)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime       @default(now())
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            AdminSession[]
}

model AdminSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Menu {
  id          String        @id @default(uuid(7)) @db.Uuid
  slug        String        @unique
  title       String
  subtitle    String?
  status      MenuStatus    @default(DRAFT)
  version     Int           @default(1)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  menuDishes  MenuDish[]
  sections    MenuSection[]
}

model Dish {
  id            Int            @id @default(autoincrement())
  slug          String         @unique
  name          String
  description   String
  prepMinutes   Int
  category      String
  accent        String?
  difficulty    DishDifficulty @default(EASY)
  servingsMin   Int
  servingsMax   Int
  ingredients   String[]       @default([])
  status        DishStatus     @default(DRAFT)
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  menuDishes    MenuDish[]
  sectionDishes SectionDish[]
  images        DishImage[]
}

model MenuDish {
  menuId      String   @db.Uuid
  dishId      Int
  recommended Boolean  @default(false)
  visible     Boolean  @default(true)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([menuId, dishId])
  @@index([menuId, visible, sortOrder])
  @@index([dishId])
}

model MenuSection {
  id        String   @id @default(uuid(7)) @db.Uuid
  menuId    String   @db.Uuid
  slug      String
  label     String
  title     String
  note      String?
  visible   Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu          Menu          @relation(fields: [menuId], references: [id], onDelete: Cascade)
  sectionDishes SectionDish[]

  @@unique([menuId, slug])
  @@index([menuId, visible, sortOrder])
}

model SectionDish {
  sectionId String   @db.Uuid
  dishId    Int
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dish    Dish        @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([sectionId, dishId])
  @@index([sectionId, sortOrder])
  @@index([dishId])
}

model DishImage {
  id         String   @id @default(uuid(7)) @db.Uuid
  dishId     Int
  storageKey String   @unique
  altText    String
  mimeType   String
  width      Int
  height     Int
  byteSize   Int
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dish Dish @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, sortOrder])
}
